# Required only for the "Ask about Hariank" chat widget (src/app/api/chat).
# Everything else on the site builds and runs without any environment variables.
#
# Free key, no credit card: https://console.groq.com/keys
#
# Copy this file to `.env.local` and put the real key THERE — `.env.local` is
# gitignored; this template is committed. Next.js only loads `.env.local`,
# never a `.example` file.
GROQ_API_KEY=your-key-here
